[Unit]
Description=opencode go quota dashboard
Documentation=https://github.com/hrodres/opencode-quota-dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
ExecStart=/usr/bin/env python3 __DIR__/serve.py --bind __BIND__ --port __PORT__
Environment=PYTHONUNBUFFERED=1
Environment=OPENCLAW_HOME=__HOME__/.openclaw
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
